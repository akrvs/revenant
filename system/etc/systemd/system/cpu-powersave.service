[Unit]
Description=Set CPU governor powersave + EPP balance_performance

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'for c in /sys/devices/system/cpu/cpu*/cpufreq; do echo powersave > "$c/scaling_governor"; echo balance_performance > "$c/energy_performance_preference"; done'

[Install]
WantedBy=multi-user.target
