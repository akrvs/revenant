 /* wallust template - colors-rofi */

* {
active-background: #FF7A93;
active-foreground: #A9B1D6;
normal-background: #1A1B26;
normal-foreground: #A9B1D6;
urgent-background: #7DA6FF;
urgent-foreground: #A9B1D6;

alternate-active-background: #AD8EE6;
alternate-active-foreground: #A9B1D6;
alternate-normal-background: #1A1B26;
alternate-normal-foreground: #A9B1D6;
alternate-urgent-background: #1A1B26;
alternate-urgent-foreground: #A9B1D6;

selected-active-background: #FF7A93;
selected-active-foreground: #A9B1D6;
selected-normal-background: #A9B1D6;
selected-normal-foreground: #A9B1D6;
selected-urgent-background: #7DA6FF;
selected-urgent-foreground: #A9B1D6;

background-color: #1A1B26;
background: rgba(0,0,0,0.7);
foreground: #C0CAF5;
border-color: #FF7A93;
}

