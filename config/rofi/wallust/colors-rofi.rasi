 /* wallust template - colors-rofi */

* {
active-background: #484750;
active-foreground: #C0C6DA;
normal-background: #0F0F12;
normal-foreground: #C0C6DA;
urgent-background: #504F5E;
urgent-foreground: #C0C6DA;

alternate-active-background: #687296;
alternate-active-foreground: #C0C6DA;
alternate-normal-background: #0F0F12;
alternate-normal-foreground: #C0C6DA;
alternate-urgent-background: #0F0F12;
alternate-urgent-foreground: #C0C6DA;

selected-active-background: #484750;
selected-active-foreground: #C0C6DA;
selected-normal-background: #9CA5C2;
selected-normal-foreground: #C0C6DA;
selected-urgent-background: #504F5E;
selected-urgent-foreground: #C0C6DA;

background-color: #0F0F12;
background: rgba(0,0,0,0.7);
foreground: #9CA5C2;
border-color: #484750;
}

