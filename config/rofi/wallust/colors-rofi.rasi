 /* wallust template - colors-rofi */

* {
active-background: #E67E80;
active-foreground: #D3C6AA;
normal-background: #2D353B;
normal-foreground: #D3C6AA;
urgent-background: #7FBBB3;
urgent-foreground: #D3C6AA;

alternate-active-background: #D699B6;
alternate-active-foreground: #D3C6AA;
alternate-normal-background: #2D353B;
alternate-normal-foreground: #D3C6AA;
alternate-urgent-background: #2D353B;
alternate-urgent-foreground: #D3C6AA;

selected-active-background: #E67E80;
selected-active-foreground: #D3C6AA;
selected-normal-background: #D3C6AA;
selected-normal-foreground: #D3C6AA;
selected-urgent-background: #7FBBB3;
selected-urgent-foreground: #D3C6AA;

background-color: #2D353B;
background: rgba(0,0,0,0.7);
foreground: #D3C6AA;
border-color: #E67E80;
}

