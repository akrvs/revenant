set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#141619"
set completion-fg "#B8CAD2"
set completion-group-bg "#141619"
set completion-group-fg "#B8CAD2"
set completion-highlight-bg "#B8CAD2"
set completion-highlight-fg "#141619"

set recolor-lightcolor "#141619"
set recolor-darkcolor "#B8CAD2"
set default-bg "#8A8A8C"
set default-fg "#B8CAD2"
set inputbar-bg "#141619"
set inputbar-fg "#B8CAD2"
set notification-bg "#141619"
set notification-fg "#B8CAD2"
set notification-error-bg "#45525D"
set notification-error-fg "#B8CAD2"
set notification-warning-bg "#45525D"
set notification-warning-fg "#B8CAD2"
set statusbar-bg "#5A5C5E"
set statusbar-fg "#D3DCE0"
set index-bg "#455E6E"
set index-fg "#B8CAD2"
set index-active-bg "#B8CAD2"
set index-active-fg "#141619"
set render-loading-bg "#141619"
set render-loading-fg "#B8CAD2"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

