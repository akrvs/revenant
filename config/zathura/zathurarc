set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#2D353B"
set completion-fg "#D3C6AA"
set completion-group-bg "#2D353B"
set completion-group-fg "#D3C6AA"
set completion-highlight-bg "#D3C6AA"
set completion-highlight-fg "#2D353B"

set recolor-lightcolor "#2D353B"
set recolor-darkcolor "#D3C6AA"
set default-bg "#969A9D"
set default-fg "#D3C6AA"
set inputbar-bg "#2D353B"
set inputbar-fg "#D3C6AA"
set notification-bg "#2D353B"
set notification-fg "#D3C6AA"
set notification-error-bg "#E67E80"
set notification-error-fg "#D3C6AA"
set notification-warning-bg "#E67E80"
set notification-warning-fg "#D3C6AA"
set statusbar-bg "#6C7276"
set statusbar-fg "#E1DACC"
set index-bg "#A7C080"
set index-fg "#D3C6AA"
set index-active-bg "#D3C6AA"
set index-active-fg "#2D353B"
set render-loading-bg "#2D353B"
set render-loading-fg "#D3C6AA"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

