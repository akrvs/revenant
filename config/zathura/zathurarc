set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#26202B"
set completion-fg "#FDDBD1"
set completion-group-bg "#26202B"
set completion-group-fg "#FDDBD1"
set completion-highlight-bg "#FDDBD1"
set completion-highlight-fg "#26202B"

set recolor-lightcolor "#26202B"
set recolor-darkcolor "#FDDBD1"
set default-bg "#929095"
set default-fg "#FDDBD1"
set inputbar-bg "#26202B"
set inputbar-fg "#FDDBD1"
set notification-bg "#26202B"
set notification-fg "#FDDBD1"
set notification-error-bg "#644A82"
set notification-error-fg "#FDDBD1"
set notification-warning-bg "#644A82"
set notification-warning-fg "#FDDBD1"
set statusbar-bg "#67636B"
set statusbar-fg "#F6E5E0"
set index-bg "#B265A6"
set index-fg "#FDDBD1"
set index-active-bg "#FDDBD1"
set index-active-fg "#26202B"
set render-loading-bg "#26202B"
set render-loading-fg "#FDDBD1"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

