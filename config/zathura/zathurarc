set database "sqlite"
set recolor "false"
set recolor-keephue "true"
set completion-bg "#0C0B0C"
set completion-fg "#FAFCFB"
set completion-group-bg "#0C0B0C"
set completion-group-fg "#FAFCFB"
set completion-highlight-bg "#FAFCFB"
set completion-highlight-fg "#0C0B0C"

set recolor-lightcolor "#0C0B0C"
set recolor-darkcolor "#FAFCFB"
set default-bg "#868586"
set default-fg "#FAFCFB"
set inputbar-bg "#0C0B0C"
set inputbar-fg "#FAFCFB"
set notification-bg "#0C0B0C"
set notification-fg "#FAFCFB"
set notification-error-bg "#C38B7B"
set notification-error-fg "#FAFCFB"
set notification-warning-bg "#C38B7B"
set notification-warning-fg "#FAFCFB"
set statusbar-bg "#555455"
set statusbar-fg "#F4F5F5"
set index-bg "#87A9B0"
set index-fg "#FAFCFB"
set index-active-bg "#FAFCFB"
set index-active-fg "#0C0B0C"
set render-loading-bg "#0C0B0C"
set render-loading-fg "#FAFCFB"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

map i recolor 
set adjust-open "best-fit"

